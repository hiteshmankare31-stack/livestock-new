PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_livestock
AI_SERVICE_URL=http://127.0.0.1:8001/predict
TRANSLATION_API_URL=https://translation.googleapis.com/language/translate/v2
TRANSLATION_API_KEY=PUT_YOUR_GOOGLE_TRANSLATION_API_KEY_HERE

# Security
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
FRONTEND_ORIGIN=http://localhost:5500
# Demo password fallback (change before deployment)
DEMO_PASSWORD=CHANGE_THIS_PASSWORD
# Optional role-specific passwords; these override DEMO_PASSWORD
FARMER_PASSWORD=CHANGE_FARMER_PASSWORD
VET_PASSWORD=CHANGE_VET_PASSWORD
GOV_PASSWORD=CHANGE_GOV_PASSWORD

# Surveillance thresholds; system alerts only, not official declarations.
HOTSPOT_CASE_THRESHOLD=3
INFECTED_ZONE_CASE_THRESHOLD=5
HOTSPOT_DAYS=7
